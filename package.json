{
  "name": "clipframes",
  "private": true,
  "version": "0.1.0",
  "description": "WebGL video transitions for React: 25 scrubable cuts rendered live in the browser.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:file": "tsc --noEmit && vite build --config vite.config.single.ts && node scripts/package-single.mjs",
    "preview": "vite preview",
    "build:lib": "vite build --config vite.lib.config.ts"
  },
  "dependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
